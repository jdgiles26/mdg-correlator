# Core
APP_NAME=Federated Mission Data Grid
API_PORT=8080
UI_PORT=5173

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=missiongrid
POSTGRES_USER=missiongrid
POSTGRES_PASSWORD=missiongrid

# NATS
NATS_URL=nats://nats:4222

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mission-objects

# MediaMTX
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888

# Embeddings + intelligence layer (requires Qdrant)
ENABLE_EMBEDDINGS=true
QDRANT_URL=http://qdrant:6333

